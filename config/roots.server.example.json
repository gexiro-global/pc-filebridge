{
  "version": 1,
  "roots": [
    {
      "id": "server-data",
      "label": "Persistent server data",
      "path": "/data/global",
      "read": true,
      "create": true
    }
  ],
  "limits": {
    "maxReadBytes": 262144,
    "maxWriteBytes": 1048576,
    "maxDirectoryEntries": 250,
    "maxSearchResults": 100,
    "maxSearchEntries": 5000
  }
}
